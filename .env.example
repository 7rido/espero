# espero — environment template. Copy to .env and fill in what you use:
#
#     cp .env.example .env
#
# .env is gitignored and read by espero at start (existing shell variables win).
# Nothing here is required for the paper books, the research scripts or the UI;
# they all run on public endpoints with no key. Leave a line empty to leave the
# feature off. Never paste a key into a chat, a commit or a screenshot.

# ---------------------------------------------------------------- Hyperliquid
# Network for every Hyperliquid call: "testnet" (default for development) or
# "mainnet". Testnet UI and faucet: https://app.hyperliquid-testnet.xyz
# Testnet API: https://api.hyperliquid-testnet.xyz   Mainnet: https://api.hyperliquid.xyz
HL_NETWORK=testnet
# Override the API base URL (rarely needed; derived from HL_NETWORK when empty)
HL_API_URL=
# Public wallet address (0x...) to read testnet account state, positions and
# fills. Reading needs no signature.
HL_WALLET_ADDRESS=
# API wallet private key for signing *testnet* orders (espero/hl_exchange.py, the
# only code that reads it). Generate a dedicated API wallet in the testnet UI
# (app.hyperliquid-testnet.xyz -> More -> API) and fund the account from the
# faucet; never reuse a mainnet key. Signing refuses to run unless HL_NETWORK is
# testnet AND ESPERO_ALLOW_HL_TESTNET=1; mainnet signing is not implemented.
HL_PRIVATE_KEY=
ESPERO_ALLOW_HL_TESTNET=

# -------------------------------------------------------------------- Coinbase
# Coinbase *Exchange* API key, for `espero fees` only (your maker/taker rates,
# GET /fees). Create it with the "view" permission and nothing else. No key in
# this file can place an order: the repo has no mainnet order path.
COINBASE_EXCHANGE_KEY=
COINBASE_EXCHANGE_SECRET=
COINBASE_EXCHANGE_PASSPHRASE=

# ---------------------------------------------------------------- notifications
# Webhook (Slack/Discord-style JSON POST) for the daily job's summary and alerts.
ESPERO_WEBHOOK_URL=

# ---------------------------------------------------------------- data release
# Maintainer only. The gh account that owns the public repo (e.g. 7rido). When set, the
# daily job publishes the live recordings as a release every Monday (scripts/publish-data.sh),
# using that account's token without switching the active gh account. Leave it empty on a
# teammate's machine: their daily run then never publishes.
ESPERO_PUBLISH_AS=

# ---------------------------------------------------------------------- paths
# Cache for Yahoo/FRED series (default data/cache)
ESPERO_CACHE=
# Log directory for the launchd daily job (default ~/Library/Logs/espero)
ESPERO_LOG_DIR=
