# Grouped by what a file is, so the rule for a new file is its class, not its test number.

# ---- Python, tooling, OS
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
.venv-pit/
venv/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/
results/
*.log
.DS_Store

# ---- secrets: the template is committed, the real file never is
.env
.env.*
!.env.example

# ---- account state and ledgers. Written by `espero daily` and the loops; the repo root is the
# state folder for now. Every *.db is an account or a journal, except the committed features fixture.
*.db
!features.db
*.db-wal
*.db-shm
*.db.lock
/*.csv
dashboard.html
KILL
state/
docker-state/
paper-books/

# ---- data, class 1: committed fixtures. Nothing here is ignored: data/*.csv, data/panel*/,
# data/trend/, data/aggr/explore/, data/aggr/holdout/ and the degen bars #10's numbers came from.

# ---- data, class 2: caches fetched from a public archive by the script that uses them.
# Safe to delete; the script downloads them again (docs/DATA.md, section 2).
data/cache/
data/lows/
data/liq/
data/liq2/
data/oi/
data/settle/
data/levetf/
data/bids/
data/markout/
data/markout_small/
data/polymarket/
data/funding/
data/rate/
data/degen/*
research/data/

# ---- data, class 3: tick days from Tardis and Binance, tens of gigabytes, fetchable again with time.
data/pit/
data/patterns/
data/bookwalk/

# ---- data, class 4: recordings that cannot be fetched again. Hyperliquid serves no history and
# aggr deletes its bars after days. They live in the weekly release (scripts/publish-data.sh), each
# with a MANIFEST.sha256 (python -m espero.manifest). Ignored so that `git clean -fd` and `git add -A`
# never touch them; `git clean -x` still would, so never run it. Never delete them. data/lows/forward/
# is the same class but is under data/lows/.
data/hlcollect/
data/hlbook/
data/book/
data/aggr/forward/
data/aggr/forward5m/
