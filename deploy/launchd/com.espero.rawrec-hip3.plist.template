<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.espero.rawrec-hip3</string>

    <!-- the second raw recorder (espero/hip3rec.py): trade.xyz's books and trades for #74, one public
         websocket feed, nothing signs or trades; scripts/install-rawrec-hip3-launchd.sh renders this. It
         writes only ESPERO_RAW_DIR_HIP3, a folder of its own, never the first recorder's tape or data/. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>espero</string>
        <string>hip3rec</string>
        <string>--loop</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- start at login and restart whenever the loop dies, at most once a minute. A restart appends a new
         frame to the current hour's file; what was missed while the Mac slept is a gap on the tape. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/rawrec-hip3.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/rawrec-hip3.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>ESPERO_RAW_DIR_HIP3</key>
        <string>__RAW_DIR_HIP3__</string>
        <key>ESPERO_RAW_DIR</key>
        <string>__RAW_DIR__</string>
    </dict>

    <!-- Standard, not Background: a deferred process drops frames -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
