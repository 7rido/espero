<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.espero.rawrec</string>

    <!-- the raw stream recorder (espero/rawrec.py): public websocket feeds only, nothing signs or trades;
         scripts/install-rawrec-launchd.sh renders this. It writes only ESPERO_RAW_DIR, never data/. -->
    <key>ProgramArguments</key>
    <array>
        <string>__PYTHON__</string>
        <string>-m</string>
        <string>espero</string>
        <string>rawrec</string>
        <string>--loop</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__REPO__</string>

    <!-- start at login and restart whenever the loop dies, at most once a minute. A restart appends a new
         frame to the current hour's file; what was missed while the Mac slept is a gap on the tape. -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>60</integer>

    <key>StandardOutPath</key>
    <string>__LOG_DIR__/rawrec.log</string>
    <key>StandardErrorPath</key>
    <string>__LOG_DIR__/rawrec.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/bin:/bin:/usr/sbin:/sbin:/usr/local/bin:/opt/homebrew/bin</string>
        <key>PYTHONUNBUFFERED</key>
        <string>1</string>
        <key>ESPERO_RAW_DIR</key>
        <string>__RAW_DIR__</string>
    </dict>

    <!-- Standard, not Background: a deferred process drops frames -->
    <key>ProcessType</key>
    <string>Standard</string>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
